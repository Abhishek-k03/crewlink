{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CrewLink": "Data Source=crewlink.db"
  },
  "Jwt": {
    "Issuer": "crewlink",
    "Audience": "crewlink",
    "ExpiryMinutes": 480
  },
  "NetworkSimulation": {
    "Enabled": false,
    "LatencyMinMs": 200,
    "LatencyMaxMs": 1200,
    "WriteFailureRate": 0.07
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"]
  }
}
